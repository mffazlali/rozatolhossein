# Server Configuration

# API Configuration
# Base URL for the API
NEXT_PUBLIC_API_BASE_URL=https://i.rozatolhosein.com

# API version path
NEXT_PUBLIC_API_VERSION=ape-api/v1

# Default language for API requests
NEXT_PUBLIC_API_DEFAULT_LANG=fa

# Revalidation Secret for ISR (Incremental Static Regeneration)
# Generate a secure random string for production
REVALIDATION_SECRET=your-secret-key-here

# Security Layers Configuration
# Set to 'false' to disable each security layer (default: enabled)

# محافظت در برابر درخواست‌های مشکوک RSC
NEXT_PUBLIC_ENABLE_RSC_PROTECTION=true

# اعتبارسنجی headerهای RSC
NEXT_PUBLIC_ENABLE_RSC_HEADER_VALIDATION=true

# محافظت در برابر حملات Server Action
NEXT_PUBLIC_ENABLE_SERVER_ACTION_PROTECTION=true

# محافظت در برابر دستکاری Header
NEXT_PUBLIC_ENABLE_HEADER_MANIPULATION_PROTECTION=true

# محافظت در برابر RCE و Prototype Pollution
NEXT_PUBLIC_ENABLE_RCE_PROTECTION=true
